DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=public"
NODE_ENV=development
PORT=3000
NODE_ID=booking-node-local

# Limitadores de memoria por instancia: activos por defecto.
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_ALLOW_TEST_AUTH=false
TELEMETRY_RATE_LIMIT_MAX=60
CHATBOT_RATE_LIMIT_MAX=20

# ── Envío de facturas por correo (SMTP de Gmail) ─────────────────────────────
# El PDF se genera en el navegador y el backend solo lo reenvía como adjunto.
# Gmail exige una "Contraseña de aplicación" (Account Settings -> Security ->
# 2-Step Verification -> App passwords), NO la contraseña de la cuenta.
# Si faltan SMTP_HOST, SMTP_USER o SMTP_PASS, `POST /api/v1/facturas/enviar`
# responde 503 y el resto de la API sigue funcionando.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu.cuenta@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Remitente visible. Si se omite, se usa "Booking Ecuador <SMTP_USER>".
# MAIL_FROM="Booking Ecuador <facturas@tu.cuenta.com>"

# Base publica del frontend, para el enlace "Ver mis reservas" del correo.
# FRONTEND_URL=http://localhost:5173

# ── Chatbot informativo (Groq) ───────────────────────────────────────────────
# El bot responde consultas de disponibilidad de vuelos, autos y atracciones
# consultando esta misma API por HTTP. Es de SOLO LECTURA: no reserva, no paga y
# no cancela nada.
#
# Si falta GROQ_API_KEY el servidor IGUAL ARRANCA y el resto de la API sigue
# funcionando; solo `POST /api/v1/chatbot/mensaje` responde 503. Comprueba el
# estado con: GET /api/v1/chatbot/estado
GROQ_API_KEY=gsk_aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890abcdefghijklmn

# Modelo de Groq. OJO: `llama-3.3-70b-versatile` ya NO está en el catálogo de
# Groq (responde 404) y este bot usa tool-calling, así que no sirve.
# `openai/gpt-oss-120b` es el sustituto con mejor tool-calling y ventana de 131k.
GROQ_MODEL=openai/gpt-oss-20b

# Esfuerzo de razonamiento del modelo (solo modelos gpt-oss): low | medium | high.
# `low` porque en un chat de consulta la latencia se nota más que la profundidad:
# cada turno son dos llamadas al modelo.
GROQ_REASONING=low

# Base de la API de datos que consulta el bot. Por defecto se apunta al propio
# servidor. Fijarla a una URL externa es lo que hace falta si el bot se despliega
# como proceso aparte: el codigo no cambia.
# CHATBOT_API_BASE_URL=http://127.0.0.1:3000/api/v1

# ── Chatbot informativo (Groq) ───────────────────────────────────────────────
# El bot responde consultas de disponibilidad de vuelos, autos y atracciones
# consultando esta misma API por HTTP. Es de SOLO LECTURA: no reserva, no paga y
# no cancela nada.
#
# Si falta GROQ_API_KEY el servidor IGUAL ARRANCA y el resto de la API sigue
# funcionando; solo `POST /api/v1/chatbot/mensaje` responde 503. Comprueba el
# estado con: GET /api/v1/chatbot/estado
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Groq. `llama-3.3-70b-versatile` es el que soporta tool-calling de
# forma estable; se deja en variable para poder cambiarlo sin recompilar.
GROQ_MODEL=llama-3.3-70b-versatile

# Base de la API de datos que consulta el bot. Por defecto se自查 el servidor.
# Apuntarlo a una URL externa es lo que hace falta si el bot se despliega como
# proceso aparte: el codigo no cambia.
# CHATBOT_API_BASE_URL=http://127.0.0.1:3000/api/v1
LOG_SERVICE_NAME=booking-gateway
LOG_TO_STDOUT=false
LOG_RETENTION_DAYS=14

# ── Orquestador de Sagas LIFO (I05) ──────────────────────────────────────────
# Modo de persistencia del estado de sagas: memory (pruebas locales) | db (producción)
SAGA_STORE=memory

PAGOS_STORE_API_KEYS=
PAGOS_SIMULADOR_HABILITADO=false

# Secretos HMAC de proveedores inbound (mínimo 16 caracteres, no reutilizar).
WEBHOOK_SECRET_VUELOS=
WEBHOOK_SECRET_AUTOS=
WEBHOOK_SECRET_ATRACCIONES=
WEBHOOK_SECRET_ALOJAMIENTOS=
WEBHOOK_RATE_LIMIT_MAX=60
