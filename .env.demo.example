# ==============================================================================
# .env.demo.example — Booking Prototipo (RDA2)
# Configuración predeterminada lista para levantar la DEMO y DEFENSA local.
# Copiar este archivo como `.env` para arrancar inmediatamente:
#   cp .env.demo.example .env
# ==============================================================================

NODE_ENV=development
PORT=3000
NODE_ID=booking-node-demo

# Base de datos local (PostgreSQL en contenedor Docker o local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_db?schema=public

# Bus de eventos: dual (RabbitMQ + Kafka) o memory (para demo sin brokers)
EVENT_BUS_MODE=dual
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KAFKA_BROKERS=localhost:9092
TELEMETRY_SINK=log

# Sagas LIFO en memoria para demostración sin dependencia estricta de tablas DB
SAGA_STORE=memory

# Servidor gRPC Inbound activo en puerto 50051
GRPC_ENABLED=true
GRPC_PORT=50051
INVENTORY_API_KEYS=key-demo-alojamientos-67890,key-demo-dilan-12345
ALOJAMIENTOS_API_KEYS=key-demo-alojamientos-67890

# Secretos HMAC para demostración de Webhooks Inbound (Cloudevents)
WEBHOOK_SECRET_VUELOS=demo-webhook-secret-vuelos-12345
WEBHOOK_SECRET_AUTOS=demo-webhook-secret-autos-12345
WEBHOOK_SECRET_ATRACCIONES=demo-webhook-secret-atracciones-12345
WEBHOOK_SECRET_ALOJAMIENTOS=demo-webhook-secret-alojamientos-12345
WEBHOOK_RATE_LIMIT_MAX=60

# Simulador de pagos activado para defensas y pruebas locales
PAGOS_SIMULADOR_HABILITADO=true
PAGOS_SIMULADOR_MODO=NORMAL
ADMIN_SECRET_KEY=Admin123!

# Seguridad y evaluación rápida
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_ALLOW_TEST_AUTH=true
TELEMETRY_RATE_LIMIT_MAX=60
CHATBOT_RATE_LIMIT_MAX=20

# Logs físicos estructurados
LOG_SERVICE_NAME=booking-demo-gateway
LOG_TO_STDOUT=true
LOG_RETENTION_DAYS=14
LOG_DIR=logs

# Adaptadores ACL hacia tiendas satélites (apuntando al mock-tienda local en :4000)
TIENDA_ATRACCIONES_URL=http://localhost:4000/api/v2
TIENDA_AUTOS_URL=http://localhost:4000/api/v2/autos
TIENDA_ALOJAMIENTOS_URL=http://localhost:4000/api/v2/alojamientos
TIENDA_VUELOS_URL=http://localhost:4000/api/v2/vuelos

# Credenciales de prueba no sensibles para Supabase en demo local
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=demo-anon-key-local
SUPABASE_SERVICE_ROLE_KEY=demo-service-role-key-local
